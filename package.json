{
  "name": "dsh-skill-doctor",
  "description": "技能和插件体检和诊断：确认模型是否能看见和使用skill、skill没被模型使用的原因、修复无法使用的skill、插件之间有没有冲突、会不会破坏harness的配置；会话内附带实时活动面板。Diagnose skills and plugins for DeepSeek Harness.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "skills",
    "skill",
    "lint",
    "doctor",
    "diagnostics",
    "agent"
  ],
  "homepage": "https://github.com/shuxidemosheng/dsh-skill-doctor#readme",
  "bugs": {
    "url": "https://github.com/shuxidemosheng/dsh-skill-doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuxidemosheng/dsh-skill-doctor.git"
  },
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./compat": {
      "default": "./lib/compat.js"
    },
    "./gate": {
      "default": "./lib/gate-entry.js"
    }
  },
  "bin": {
    "dsh-skill-lint": "lib/cli.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.en.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "client-ui-slots",
        "client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && esbuild src/index.ts --bundle --format=esm --platform=node --target=node24 --outfile=lib/index.js --legal-comments=none --packages=external && esbuild src/cli.ts --bundle --format=esm --platform=node --target=node24 --outfile=lib/cli.js --legal-comments=none --packages=external && esbuild src/compat-entry.ts --bundle --format=esm --platform=node --target=node24 --outfile=lib/compat.js --legal-comments=none --packages=external && esbuild src/gate-entry.ts --bundle --format=esm --platform=node --target=node24 --outfile=lib/gate-entry.js --legal-comments=none --packages=external && node scripts/build-client.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "e2e": "node scripts/e2e-headless.mjs --group A",
    "e2e:all": "node scripts/e2e-headless.mjs --group A,B,C,D",
    "e2e:stub": "node scripts/e2e/stub-conflict.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-working-directory": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
