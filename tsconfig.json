{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src"],
  // client.tsx 是浏览器侧代码（JSX + DOM），由 tsconfig.client.json 单独检查、
  // 由 scripts/build-client.mjs 用 esbuild 打包，不能进 Node 侧的产出。
  "exclude": ["src/client.tsx"]
}
